{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rulantu",
  "compatibility_date": "2026-08-20",
  // Pure static export (see next.config.ts: output: "export"). worker.js is
  // a thin edge redirect (www -> apex) in front of Workers Static Assets —
  // no OpenNext, no app server, no state: this repo has no backend.
  "main": "worker.js",
  // Powers /api/chat — Workers AI free tier (10,000 neurons/day), no
  // external API key, no separate account setup beyond this binding.
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Without this, Cloudflare serves matching static files directly and
    // skips worker.js entirely — which would skip the www redirect too.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "rulantu.com", "custom_domain": true },
    { "pattern": "www.rulantu.com", "custom_domain": true }
  ]
}
